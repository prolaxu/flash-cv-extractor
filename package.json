{
  "name": "flash-cv-extractor",
  "version": "0.1.0",
  "description": "Extract structured data from CV/resume PDFs, powered by a Rust PDF engine compiled to WebAssembly",
  "keywords": [
    "cv",
    "resume",
    "pdf",
    "parser",
    "extractor",
    "wasm",
    "rust"
  ],
  "license": "AGPL-3.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./wasm": "./dist/flash-cv-pdf-core.wasm"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:js": "tsup src/index.ts --format cjs,esm --dts",
    "build": "npm run build:wasm && npm run build:js",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test -p flash-cv-pdf-core",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:rust",
    "fetch-corpus": "bash scripts/fetch-corpus.sh",
    "check-corpus": "node scripts/check-corpus.mjs",
    "score-bench": "node scripts/score-bench.mjs",
    "audit-corpus": "node scripts/audit-corpus.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
